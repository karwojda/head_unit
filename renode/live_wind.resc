:name: head_unit live wind
:description: head_unit with its BLE radio (head_unit.resc) and the simulated wind sensor (nRF52840), on one BLE medium.
:
:Set $bin, $sdcard and $hci_bin as for head_unit.resc, and $sensor_bin
:(build/sensor_sim/zephyr/zephyr.elf) -- see README.md.

include $ORIGIN/head_unit.resc

mach create "sensor"
machine LoadPlatformDescription @platforms/boards/nrf52840dk_nrf52840.repl
connector Connect sysbus.radio wireless
sysbus LoadELF $sensor_bin
